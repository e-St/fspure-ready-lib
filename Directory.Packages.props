<Project>
  <!--
    FSharp.PureAnalyzer version defaults:
      - Customer / main: released version on nuget.org (see below).
      - Dev branch CI: scripts set FspureAnalyzerVersion to latest GitHub Packages build.
    Override anytime: /p:FspureAnalyzerVersion=... or env FspureAnalyzerVersion.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!--
      Default pin: nuget.org Phase 3+ analyzer (build/ + tools/fspure-collector/).
      Dev satellite CI may override with GitHub Packages *-ci.* builds.
      Monorepo gate packs a local 0.0.0-ci analyzer and never uses this pin.
    -->
    <FspureAnalyzerVersion Condition="'$(FspureAnalyzerVersion)' == ''">0.4.0</FspureAnalyzerVersion>
    <FspureReadyLibVersion Condition="'$(FspureReadyLibVersion)' == ''">0.1.0-preview.1</FspureReadyLibVersion>
  </PropertyGroup>
</Project>
