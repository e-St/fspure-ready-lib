<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local CI feed: packed Fspure.ReadyLib and optional local analyzer nupkg. -->
    <add key="local-artifacts" value="./artifacts/packages" />
    <!-- e-St monorepo packages (FSharp.PureAnalyzer). Auth required; see scripts/use-github-packages.sh -->
    <add key="github-e-st" value="https://nuget.pkg.github.com/e-St/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
    Map FSharp.PureAnalyzer only to GitHub Packages (+ local override).
    Do not use a catch-all on nuget.org for that id (would pick stale nuget.org builds).
    Other packages still come from nuget.org via the star pattern.
  -->
  <packageSourceMapping>
    <packageSource key="local-artifacts">
      <package pattern="Fspure.*" />
      <package pattern="FSharp.PureAnalyzer" />
    </packageSource>
    <packageSource key="github-e-st">
      <package pattern="FSharp.PureAnalyzer" />
      <package pattern="purity-collector" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="FSharp.*" />
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="xunit*" />
      <package pattern="Newtonsoft.*" />
      <package pattern="NuGet.*" />
      <package pattern="runtime.*" />
      <package pattern="NETStandard.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
