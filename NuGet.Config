<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local pack output (Fspure.ReadyLib nupkg during CI). -->
    <add key="local-artifacts" value="./artifacts/packages" />
    <!-- Public releases (customer-facing default). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      GitHub Packages is NOT listed by default (unauthenticated 401 breaks
      TreatWarningsAsErrors restores / security audit).
      Dev CI adds it via: bash scripts/use-github-packages.sh
    -->
  </packageSources>
</configuration>
