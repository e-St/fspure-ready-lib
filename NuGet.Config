<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local pack output (Fspure.ReadyLib nupkg during CI). -->
    <add key="local-artifacts" value="./artifacts/packages" />
    <!-- Public releases (customer-facing default). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Optional: e-St monorepo pre-release packages. Not used on main CI.
      Dev branch CI authenticates this source via scripts/use-github-packages.sh.
    -->
    <add key="github-e-st" value="https://nuget.pkg.github.com/e-St/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
