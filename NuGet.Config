<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local CI feed (Fspure.ReadyLib pack output, optional local analyzer nupkg). -->
    <add key="local-artifacts" value="./artifacts/packages" />
    <!--
      e-St monorepo GitHub Packages (FSharp.PureAnalyzer with Phase 3 targets).
      Auth is required even for public packages: set credentials in CI via
      `dotnet nuget update source` / add source with --password GITHUB_TOKEN.
      See scripts/use-github-packages.sh and .github/workflows/ci.yml.
    -->
    <add key="github-e-st" value="https://nuget.pkg.github.com/e-St/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Prefer GitHub Packages over nuget.org when the same id exists on both. -->
  <packageSourceMapping>
    <packageSource key="local-artifacts">
      <package pattern="Fspure.ReadyLib" />
      <package pattern="Fspure.ReadyLib.*" />
      <package pattern="FSharp.PureAnalyzer" />
    </packageSource>
    <packageSource key="github-e-st">
      <package pattern="FSharp.PureAnalyzer" />
      <package pattern="purity-collector" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
