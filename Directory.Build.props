<Project>
  <!--
    Sample / satellite repo: same compiler strictness as monorepo root + fspure embed defaults.
    When nested under e-St/fspure, MSBuild also imports the monorepo Directory.Build.props
    (outer → inner); properties here reinforce the same rules for the standalone satellite.
  -->
  <PropertyGroup>
    <!-- === Compiler Strictness (match e-St/fspure + e-St/fstarter) === -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);FS0049;FS0020</WarningsNotAsErrors>

    <!-- Phase 3 embed (default true when package is referenced; kept explicit for clarity). -->
    <FspureEmbedPureJson>true</FspureEmbedPureJson>
  </PropertyGroup>
</Project>
