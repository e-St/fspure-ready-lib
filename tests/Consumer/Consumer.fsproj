<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsFspureReadyLibrary>false</IsFspureReadyLibrary>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Prefer PackageReference to the packed sample (CI packs then restores from artifacts/packages).
      For a quick local loop without pack, switch to ProjectReference (commented below).
    -->
    <PackageReference Include="Fspure.ReadyLib" Version="$(FspureReadyLibVersion)" />
    <!--
    <ProjectReference Include="..\..\src\Fspure.ReadyLib\Fspure.ReadyLib.fsproj" />
    -->
  </ItemGroup>
</Project>
