<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsFspureReadyLibrary>false</IsFspureReadyLibrary>
    <!--
      Phase 5: same project, two reference styles (no second consumer project).
        PackageReference (default):  restore packed Fspure.ReadyLib from local feed
        ProjectReference:            /p:FspureReadyLibUseProjectReference=true
    -->
    <FspureReadyLibUseProjectReference Condition="'$(FspureReadyLibUseProjectReference)' == ''">false</FspureReadyLibUseProjectReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FspureReadyLibUseProjectReference)' != 'true'">
    <PackageReference Include="Fspure.ReadyLib" Version="$(FspureReadyLibVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FspureReadyLibUseProjectReference)' == 'true'">
    <ProjectReference Include="..\..\src\Fspure.ReadyLib\Fspure.ReadyLib.fsproj" />
  </ItemGroup>
</Project>
